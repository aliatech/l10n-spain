<odoo>
    <record id="invoice_sii_invoice_summary_form_view" model="ir.ui.view">
        <field name="name">account.invoice.sii.invoice.summary.form.view</field>
        <field name="model">account.invoice</field>
        <field name="inherit_id" ref="l10n_es_aeat_sii.invoice_sii_form"/>
        <field name="arch" type="xml">
            <field name="sii_description" position="before">
                <field
                    name="is_invoice_summary"
                    attrs="{
                       'invisible': [('type', 'not in', ('out_invoice','out_refund'))],
                       'readonly' : [('state', '!=', 'draft')]
                   }"
                />
                <field
                    name="sii_invoice_summary_start"
                    string="First Invoice"
                    attrs="{
                       'invisible': ['|', ('type','not in',('out_invoice','out_refund')), ('is_invoice_summary','=',False)],
                       'readonly' : [('state','!=','draft')],
                       'required' : [('is_invoice_summary','=',True)]
                    }"
                />
                <field
                    name="sii_invoice_summary_end"
                    string="Last Invoice"
                    attrs="{
                       'invisible': ['|', ('type','not in',('out_invoice','out_refund')), ('is_invoice_summary','=',False)],
                       'readonly' : [('state','!=','draft')],
                       'required' : [('is_invoice_summary','=',True)]
                   }"
                />
            </field>
        </field>
    </record>
</odoo>


